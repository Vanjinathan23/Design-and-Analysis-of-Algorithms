def rob_linear(nums):
    prev2 = 0
    prev1 = 0

    for money in nums:
        current = max(prev1, prev2 + money)

        prev2 = prev1
        prev1 = current

    return prev1


def rob(nums):
    n = len(nums)

    if n == 0:
        return 0

    if n == 1:
        return nums[0]

    # Case 1: Don't rob first house
    case1 = rob_linear(nums[1:])

    # Case 2: Don't rob last house
    case2 = rob_linear(nums[:-1])

    return max(case1, case2)


print(rob([2, 3, 2]))
# Output: 3

print(rob([1, 2, 3, 1]))
# Output: 4
